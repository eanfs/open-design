# Aurora reference deployment environment. Copy to .env and fill in secrets.
# Values marked (required) must be set; the compose fails to start otherwise.

# --- OpenDesign tenant image ------------------------------------------------
# The standard OpenDesign image; Aurora does not ship a DSH-only variant, so
# each tenant serves whatever agent providers the operator configures for it.
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest

# --- Control plane (AURORA_*) ------------------------------------------------
# Origin browsers use to reach the gateway; used for CSRF checks and OIDC
# redirect URIs. Must match the origin the Aurora web is served from.
AURORA_PUBLIC_ORIGIN=https://aurora.example.com

# OIDC provider (any OpenID Connect issuer).
AURORA_OIDC_ISSUER=
AURORA_OIDC_CLIENT_ID=aurora-web
AURORA_OIDC_CLIENT_SECRET=

# HMAC key protecting the short-lived OIDC login-state cookie. Generate with:
#   openssl rand -hex 32
AURORA_LOGIN_STATE_SIGNING_SECRET=

# Stripe commerce.
AURORA_STRIPE_SECRET_KEY=sk_test_...
AURORA_STRIPE_WEBHOOK_SECRET=whsec_...

# Optional tunables.
# AURORA_HOST=0.0.0.0
# AURORA_PORT=3000
# AURORA_SESSION_TTL_SECONDS=3600
# AURORA_LOGIN_STATE_TTL_SECONDS=600

# --- PostgreSQL ---------------------------------------------------------------
# The compose assembles AURORA_DATABASE_URL from these; only change the
# defaults when the password differs from the user.
AURORA_POSTGRES_USER=aurora
AURORA_POSTGRES_PASSWORD=aurora
AURORA_POSTGRES_DB=aurora

# --- Published ports (host-local only) -----------------------------------------
AURORA_CONTROL_PLANE_PORT=3000
AURORA_TENANT_A_PORT=17456
AURORA_TENANT_B_PORT=17457

# --- Per-tenant provider credentials ------------------------------------------
# Inject each tenant's own provider credentials with an env_file per tenant
# (tenant-a.env / tenant-b.env) added to the tenant services in
# deploy/aurora/docker-compose.yml, or as explicit `environment` keys. Tenant
# A and B must never share credentials. Example tenant-a.env:
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...

# --- Resource limits -----------------------------------------------------------
# AURORA_TENANT_MEM_LIMIT=384m
# AURORA_TENANT_CPUS=1
# AURORA_CONTROL_PLANE_MEM_LIMIT=384m
